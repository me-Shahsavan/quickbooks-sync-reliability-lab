# --- Webhook receiver (chapter 01) ---
# The verifier token shown on your app's Webhooks page in the Intuit Developer portal.
# Used to validate the `intuit-signature` header (HMAC-SHA256 over the raw body).
# Leave empty to run the receiver with signature validation disabled (local experiments only).
WEBHOOK_VERIFIER_TOKEN=

# Port for the local webhook receiver.
PORT=3000

# --- QBO sandbox client (used by live repros in later chapters) ---
# All chapters ship with recorded fixtures and run offline by default.
# Fill these only when you want to reproduce a failure against your own sandbox company.
QBO_ACCESS_TOKEN=
QBO_REALM_ID=
QBO_BASE_URL=https://sandbox-quickbooks.api.intuit.com
